# Hosted Supabase project — Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HTTP
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated browser origins allowed to call this API.
# 3000 = odys-customer, 3001 = odys-vendor
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# AUTH STUB — development only.
# When a request carries no `Authorization: Bearer <jwt>`, the API acts as this
# user. `npm run db:seed` prints the demo customer's id; paste it here.
# Ignored when NODE_ENV=production.
DEV_AUTH_USER_ID=
